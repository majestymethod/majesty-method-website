# ---- Required ----
# Public URL of the site (used for canonical URLs, sitemap, unsubscribe links)
SITE_URL=https://www.majestymethod.com
# Long random string (32+ chars). Signs unsubscribe links, download tokens and form tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me

# Where the database, uploaded media and private resource files live.
# Must be a persistent disk in production. Back this folder up.
DATA_DIR=./data

# ---- Google Sheets (Bootcamp registrations) ----
# URL of the deployed Google Apps Script web app (see integrations/google-apps-script/README.md)
SHEETS_WEBHOOK_URL=
# Shared secret; must match the SHARED_SECRET script property in Apps Script
SHEETS_WEBHOOK_SECRET=

# ---- Email (optional; acknowledgements + team notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Majesty Method <hello@majestymethod.com>" (domain must be authorised with SPF/DKIM)
SMTP_FROM=
